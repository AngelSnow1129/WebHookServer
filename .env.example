# Server
SERVER_ADDR=:53340

# MySQL DSN: user:password@tcp(host:port)/dbname?parseTime=true&loc=Local
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/smsdb?parseTime=true&loc=Local

# HMAC secret for phone token generation (REQUIRED, min 16 chars)
HMAC_SECRET=your-secret-key-here-change-in-production

# Webhook secret for SMS webhook authentication (REQUIRED, min 16 chars)
WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# OTP cache TTL in minutes (default: 5)
OTP_CACHE_TTL_MINUTES=5

# Cleanup interval in seconds (default: 30)
CLEANUP_INTERVAL_SECONDS=30
